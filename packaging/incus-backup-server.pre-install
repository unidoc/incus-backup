#!/bin/sh
# System account of incus-backup-server: no login shell, no password, home is
# the state directory (created by the package, 0750). -S makes both calls
# idempotent on reinstall; an existing account is kept as it is.
addgroup -S incus-backup 2>/dev/null
adduser -S -D -H -h /var/lib/incus-backup-server -s /sbin/nologin \
	-G incus-backup -g "incus-backup server" incus-backup 2>/dev/null
exit 0
